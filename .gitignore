# ---- OS / 편집기 ----
.DS_Store
Thumbs.db
*.swp

# ---- 파이썬 ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.env
.env.*
!.env.example

# ---- 용량이 크거나 기계가 만드는 산출물 ----
# 데이터·모델은 저장소가 아니라 각자 PC 에 둡니다.
# .gitkeep 은 빈 디렉터리 구조만 남기기 위한 것이라 예외로 둡니다.
data/raw/*
!data/raw/.gitkeep
data/processed/
models/*
!models/.gitkeep
assets/tts_cache/*
!assets/tts_cache/.gitkeep

# 측정·검수 결과. 검수표에는 검수자 이름이, 녹음 정답 파일에는 대화 내용이 들어갑니다.
# 예전부터 공유하던 자산 점검 결과(assets.json)만 저장소에 둡니다.
reports/*
!reports/assets.json

# 폰트는 라이선스가 제각각이라 각자 내려받게 합니다.
assets/fonts/*
!assets/fonts/.gitkeep
